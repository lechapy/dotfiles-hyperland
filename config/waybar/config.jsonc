{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 10,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/updates", "custom/power_profile", "battery", "network", "cpu", "temperature", "custom/gpu", "memory", "pulseaudio", "bluetooth", "tray", "custom/power"],
    
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    
    "clock": {
        "format": "󰸗 {:%H:%M | %d/%m/%Y}"
    },
    
    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "({temperatureC}°C)",
        "interval": 2
    },
    
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{print \"󰢮 \" $1 \"% (\" $2 \"°C)\"}'",
        "interval": 2,
        "format": "{}"
    },
    
    "memory": {
        "format": " {percentage}%",
        "interval": 2
    },
    
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 ETH",
        "format-disconnected": "󰖪 Sin red",
        "on-click": "nm-connection-editor"
    },
    
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {num_connections}",
        "format-disabled": "󰂲 Off",
        "on-click": "blueman-manager"
    },
    
    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
    },
    
    "custom/updates": {
        "exec": "echo \"$(checkupdates | wc -l) + $(yay -Qum | wc -l)\" | bc",
        "interval": 300,
        "format": "󰚰 {}",
        "tooltip": true
    },
    
    "custom/power_profile": {
        "exec": "powerprofilesctl get | sed 's/performance/Heavy Duty/; s/balanced/Normal/; s/power-saver/Ahorro/'",
        "interval": 2,
        "format": " {}",
        "on-click": "powerprofilesctl set performance",
        "on-click-right": "powerprofilesctl set power-saver",
        "on-click-middle": "powerprofilesctl set balanced",
        "tooltip": true
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout"
    }
}
